# Éloquence — configuration du serveur (toutes les variables sont optionnelles)

# Port de l'API (et du site en production)
PORT=8787
# URL publique de l'app, utilisée dans les e-mails de réinitialisation
PUBLIC_URL=http://localhost:5173
# Dossier des données (SQLite + enregistrements audio) — ignoré si DATABASE_URL est défini
# DATA_DIR=./data
# Secret de signature des sessions (généré et conservé dans DATA_DIR si absent).
# Si le disque n'est pas persistant (ex. Render gratuit), définis-le explicitement,
# sinon tout le monde est déconnecté à chaque redémarrage du serveur.
# JWT_SECRET=

# --- Base de données ---------------------------------------------------------
# Par défaut : un fichier SQLite dans DATA_DIR (parfait en local, mais perdu
# si le serveur tourne sur un disque non persistant comme Render gratuit).
# Avec DATABASE_URL, le serveur utilise Postgres à la place (compatible
# Supabase gratuit) : les données survivent aux redémarrages/redéploiements.
# Format : postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# --- IA : feedback et coach -------------------------------------------------
# Avec une clé Anthropic, le feedback et le coach sont rédigés par Claude.
# Sans clé : moteur heuristique intégré (fonctionne hors ligne).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# LLM_PROVIDER=anthropic   # ou "heuristic" pour forcer le moteur local

# --- Speech-to-Text --------------------------------------------------------
# Par défaut : transcription du navigateur (Web Speech API).
# Avec une clé OpenAI, l'audio est retranscrit côté serveur (Whisper).
# OPENAI_API_KEY=
# STT_PROVIDER=openai
# STT_MODEL=whisper-1

# --- Connexion Google ------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- E-mails (réinitialisation du mot de passe) ----------------------------
# Sans clé, les e-mails sont affichés dans la console du serveur.
# RESEND_API_KEY=
# MAIL_FROM=Éloquence <bonjour@exemple.fr>
