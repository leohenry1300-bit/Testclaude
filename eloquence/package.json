{
  "name": "eloquence",
  "private": true,
  "version": "1.0.0",
  "description": "Éloquence — coach de prise de parole propulsé par l'IA",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c \"blue,magenta\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @eloquence/web",
    "dev:server": "npm run dev -w @eloquence/server",
    "build": "npm run build -w @eloquence/web",
    "start": "npm run start -w @eloquence/server",
    "test": "npm test -w @eloquence/core && npm test -w @eloquence/server",
    "typecheck": "npm run typecheck -w @eloquence/core && npm run typecheck -w @eloquence/server && npm run typecheck -w @eloquence/web"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
